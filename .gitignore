# 86nut项目 .gitignore

# 敏感信息
.env
.env.local
.env.production
.env.staging
*.key
*.pem
config/secrets.json

# Python相关
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
venv/
env/
ENV/
env.bak/
venv.bak/
rag_env/

# IDE和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 日志文件
*.log
logs/
*.log.*

# 临时文件
*.tmp
*.temp
*.bak
*.backup
temp/
tmp/

# 临时忽略新武器文件（需要时可以移除此行）
# 雷霆之怒_90级光剑.equ

# 大型数据文件和索引
*.pkl
*.index
*.faiss
data/simple_index.pkl
data/faiss_index/
data/embeddings/
data/cache/

# 模型缓存
.cache/
model_cache/
transformers_cache/

# 测试输出
test_output*.equ
test_*.txt
output/
results/

# 压缩文件
*.zip
*.rar
*.7z
*.tar.gz
*.tar.bz2

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# Git相关
.git/
.gitattributes

# Jupyter Notebook
.ipynb_checkpoints

# PyCharm
.idea/

# 文档构建输出
docs/_build/
site/

# 配置备份
config/*.backup
*.conf.bak

# 运行时文件
*.pid
*.sock

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 编译文件
*.pyc
*.pyo

# 特定项目排除
# 排除大型参考资料中的二进制文件
DNF文件知识库/参考资料/**/*.exe
DNF文件知识库/参考资料/**/*.dll
DNF文件知识库/参考资料/**/*.bin

# 排除修改后的模组文件中的大型文件
DNF文件知识库/修改后的模组文件/**/*.pvf
DNF文件知识库/修改后的模组文件/**/*.img

# 排除收集的项目中的大型文件
DNF文件知识库/参考资料/收集的nut项目/**/*.zip
DNF文件知识库/参考资料/收集的nut项目/**/*.rar