	5

// 使用效果
[use effect]
	[immediate_recovery]
		`mp_recovery_percent`	50	// 瞬间恢复50% MP
	[/immediate_recovery]
	[continuous_recovery]
		`mp_recovery_per_second`	2	// 每秒恢复2% MP
		`duration`	30000	// 持续30秒
	[/continuous_recovery]
[/use effect]

// 药剂属性
[potion property]
	`mana_surge_chance`	25	// 魔力涌动几率25%
	`auto_use_on_death`	1	// 死亡时自动使用
	`stack_bonus`	20	// 叠加使用增强20%
[/potion property]

// 特殊效果
[special effects]
	[mana_surge]
		`magic_attack_increase`	30	// 魔攻+30%
		`cast_speed_increase`	25	// 施法速度+25%
		`mp_cost_reduction`	20	// MP消耗减少20%
		`duration`	60000	// 持续60秒
	[/mana_surge]
	[passive_mp_bonus]
		`max_mp_increase_per_10_potions`	5	// 每10瓶药剂最大MP+5%
	[/passive_mp_bonus]
[/special effects]

// 炼金配方
